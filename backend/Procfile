web: echo "=== Seeding static assets into volume ===" && cp -rn storage/seed-uploads/* public/assets/uploads/ 2>/dev/null && echo "Seeded $(ls storage/seed-uploads/images/ 2>/dev/null | wc -l) static files" && until php artisan tinker --execute="DB::connection()->getPdo();" 2>/dev/null; do echo "Waiting for database..."; sleep 5; done && { php artisan railway:fix-migrations || echo "railway:fix-migrations failed (continuing)"; } && { php artisan migrate --force || echo "migrate failed (continuing)"; } && { php artisan version:sync || echo "version:sync failed (continuing)"; } && echo "Starting scheduler in background..." && (php artisan schedule:work >> /proc/1/fd/1 2>&1 &) && php artisan serve --host=0.0.0.0 --port=$PORT
